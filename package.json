{
  "name": "vue-chat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder --win",
    "electron:dir": "vite build && electron-builder --win dir"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "cannon-es": "^0.20.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lz-string": "^1.5.0",
    "pinia": "^3.0.3",
    "three": "^0.160.1",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.89.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.5"
  },
  "build": {
    "appId": "com.perlica.endfieldbaker",
    "productName": "EndfieldBakerChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
